{
    "oldCataloguePreserved":  true,
    "newCatalogueCreated":  true,
    "destructiveMerge":  false,
    "requiredMapping":  [
                            "OLD_ID",
                            "NEW_ID",
                            "OLD_NAME",
                            "NEW_NAME",
                            "OLD_CATEGORY",
                            "NEW_CATEGORY",
                            "SOURCE",
                            "STATUS",
                            "DUPLICATE",
                            "MERGED_INTO",
                            "NOTES"
                        ],
    "rules":  [
                  "Never silently delete a catalogue record",
                  "Never invent product information",
                  "Never overwrite original source catalogue",
                  "Every migration must have traceability",
                  "Duplicates require explicit reconciliation",
                  "Shared products must not be duplicated unnecessarily"
              ]
}
