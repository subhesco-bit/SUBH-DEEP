# .env.example - AFRERA Platform Environment Configuration

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database
DATABASE_URL=postgresql://username:password@localhost:5432/afrera_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=afrera_db
DATABASE_USER=username
DATABASE_PASSWORD=password
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# MongoDB Database
MONGODB_URL=mongodb://localhost:27017/afrera_mongo
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=afrera_mongo

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ Message Queue
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Elasticsearch Search
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# =============================================================================
# CLAUDE AI CONFIGURATION
# =============================================================================

# Claude AI API
CLAUDE_AI_ENABLED=true
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.7

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_min_32_characters
JWT_EXPIRY=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_here_min_32_characters
JWT_REFRESH_EXPIRY=30d

# Encryption
ENCRYPTION_KEY=your_encryption_key_here_32_characters
ENCRYPTION_ALGORITHM=aes-256-gcm

# MFA Configuration
MFA_ENABLED=true
MFA_ISSUER=AFRERA
MFA_SECRET_LENGTH=32

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server
PORT=3001
NODE_ENV=development
API_VERSION=v1

# CORS
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Twilio (SMS/WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=afrera-uploads

# Firebase
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# Monitoring
SENTRY_DSN=your_sentry_dsn
SENTRY_ENVIRONMENT=development

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# Frontend API
VITE_API_URL=http://localhost:3001/api/v1
VITE_WS_URL=ws://localhost:3001

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Feature Flags
FEATURE_AI_COPILOT=true
FEATURE_MFA=true
FEATURE_GDPR=true
FEATURE_BLOCKCHAIN=true
FEATURE_IOT=true
FEATURE_VOICE_AI=true
FEATURE_OMNICHANNEL=true

# =============================================================================
# DEVELOPMENT ONLY
# =============================================================================

# Development
DEV_MODE=true
DEV_AUTO_RELOAD=true
DEV_DEBUG=true