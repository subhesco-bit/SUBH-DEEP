{
  "build": {
    "beforeDevCommand": "cd .. && npm run dev",
    "beforeBuildCommand": "cd .. && npm run build",
    "devPath": "http://localhost:3000",
    "distDir": "../dist",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "AFRERA",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true,
        "execute": false,
        "scope": []
      },
      "window": {
        "all": false,
        "close": true,
        "hide": true,
        "show": true,
        "maximize": true,
        "minimize": true,
        "unmaximize": true,
        "unminimize": true,
        "startDragging": true,
        "setDecorations": true,
        "setAlwaysOnTop": true
      },
      "notification": {
        "all": true
      },
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": true,
        "readDir": true,
        "createDir": true,
        "removeDir": true,
        "copyFile": true,
        "moveFile": true,
        "removeFile": true,
        "exists": true,
        "scope": ["APPDATA", "LOCALDATA", "DESKTOP", "DOCUMENTS", "DOWNLOAD", "PICTURES"]
      },
      "path": {
        "all": true
      },
      "http": {
        "all": false,
        "request": true,
        "scope": ["https://**", "http://localhost:**", "http://127.0.0.1:**"]
      },
      "dialog": {
        "all": false,
        "open": true,
        "save": true,
        "message": true,
        "ask": true,
        "confirm": true
      },
      "clipboard": {
        "all": false,
        "readText": true,
        "writeText": true
      },
      "globalShortcut": {
        "all": false
      },
      "os": {
        "all": false,
        "platform": true,
        "version": true,
        "arch": true,
        "type": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.ethnoverde.afrera",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "title": "AFRERA - Agricultural Platform",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  }
}
