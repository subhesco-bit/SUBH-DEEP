# Production Environment Variables for Backend
# These should be set in your CI/CD pipeline or production environment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database
DATABASE_URL=postgresql://username:password@production-db-host:5432/afrera_prod
DATABASE_HOST=production-db-host
DATABASE_PORT=5432
DATABASE_NAME=afrera_prod
DATABASE_USER=afrera_user
DATABASE_PASSWORD=your_secure_password
DATABASE_POOL_MIN=10
DATABASE_POOL_MAX=50

# MongoDB Database
MONGODB_URL=mongodb://production-mongo-host:27017/afrera_mongo_prod
MONGODB_HOST=production-mongo-host
MONGODB_PORT=27017
MONGODB_DATABASE=afrera_mongo_prod

# Redis Cache
REDIS_URL=redis://production-redis-host:6379
REDIS_HOST=production-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# RabbitMQ Message Queue
RABBITMQ_URL=amqp://user:password@production-rabbitmq:5672
RABBITMQ_HOST=production-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=afrera_user
RABBITMQ_PASSWORD=your_rabbitmq_password

# Elasticsearch Search
ELASTICSEARCH_URL=http://production-elasticsearch:9200
ELASTICSEARCH_HOST=production-elasticsearch
ELASTICSEARCH_PORT=9200

# =============================================================================
# CLAUDE AI CONFIGURATION
# =============================================================================

# Claude AI API
CLAUDE_AI_ENABLED=true
CLAUDE_API_KEY=your_production_claude_api_key
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.7

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT Configuration
JWT_SECRET=your_production_jwt_secret_key_minimum_32_characters
JWT_EXPIRY=7d
JWT_REFRESH_SECRET=your_production_refresh_secret_key_minimum_32_characters
JWT_REFRESH_EXPIRY=30d

# Encryption
ENCRYPTION_KEY=your_production_encryption_key_32_characters
ENCRYPTION_ALGORITHM=aes-256-gcm

# MFA Configuration
MFA_ENABLED=true
MFA_ISSUER=AFRERA
MFA_SECRET_LENGTH=32

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server
PORT=3001
NODE_ENV=production
API_VERSION=v1

# CORS
CORS_ORIGIN=https://afrera.com,https://www.afrera.com
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Twilio (SMS/WhatsApp)
TWILIO_ACCOUNT_SID=your_production_twilio_account_sid
TWILIO_AUTH_TOKEN=your_production_twilio_auth_token
TWILIO_PHONE_NUMBER=your_production_twilio_phone_number

# AWS S3
AWS_ACCESS_KEY_ID=your_production_aws_access_key
AWS_SECRET_ACCESS_KEY=your_production_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=afrera-uploads-prod

# Firebase
FIREBASE_PROJECT_ID=your_production_firebase_project_id
FIREBASE_PRIVATE_KEY=your_production_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_production_firebase_client_email

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# Logging
LOG_LEVEL=warn
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# Monitoring
SENTRY_DSN=your_production_sentry_dsn
SENTRY_ENVIRONMENT=production

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# Frontend API
VITE_API_URL=https://api.afrera.com/api/v1
VITE_WS_URL=wss://api.afrera.com

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Feature Flags
FEATURE_AI_COPILOT=true
FEATURE_MFA=true
FEATURE_GDPR=true
FEATURE_BLOCKCHAIN=true
FEATURE_IOT=true
FEATURE_VOICE_AI=true
FEATURE_OMNICHANNEL=true

# =============================================================================
# PRODUCTION ONLY
# =============================================================================

# Production
DEV_MODE=false
DEV_AUTO_RELOAD=false
DEV_DEBUG=false
