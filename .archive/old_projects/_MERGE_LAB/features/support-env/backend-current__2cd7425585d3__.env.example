# Database Configuration
DATABASE_URL=postgresql://ebdesign_user:ebdesign_dev_password_change_in_prod@localhost:5432/ebdesign
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ebdesign
DB_USER=ebdesign_user
DB_PASSWORD=ebdesign_dev_password_change_in_prod

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Environment
NODE_ENV=development
PORT=3000

# Claude AI Configuration
# Set this only through an untracked local .env or deployment secret manager.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Logging
LOG_LEVEL=debug

# Security (Change in production)
JWT_SECRET=dev_jwt_secret_change_in_production
JWT_EXPIRY=7d
REFRESH_TOKEN_SECRET=dev_refresh_secret_change_in_production

# CORS
CORS_ORIGIN=http://localhost:5173

# Session
SESSION_SECRET=dev_session_secret_change_in_production

# Email (Optional for dev)
SMTP_HOST=localhost
SMTP_PORT=1025

# Feature Flags
ENABLE_MFA=true
ENABLE_GDPR=true
ENABLE_AI_FEATURES=true
