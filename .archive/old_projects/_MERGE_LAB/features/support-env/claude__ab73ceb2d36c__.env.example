# EBDESIGN Agricultural Operating System - Frontend Environment Configuration
# Copy this file to .env.local and fill in actual values for your environment

# ============================================================================
# API CONFIGURATION
# ============================================================================
VITE_API_URL=http://localhost:3000/api/v1
VITE_SOCKET_URL=http://localhost:3000
VITE_API_TIMEOUT=30000

# ============================================================================
# ENVIRONMENT
# ============================================================================
VITE_ENV=development
VITE_DEBUG=true
VITE_APP_NAME=EBDESIGN

# ============================================================================
# FEATURE FLAGS
# ============================================================================
VITE_ENABLE_AI=true
VITE_ENABLE_AI_CHAT=true
VITE_ENABLE_VOICE_AI=true
VITE_ENABLE_IMAGE_AI=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_REAL_TIME_UPDATES=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_PUSH_NOTIFICATIONS=true

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=

# Weather Service
VITE_WEATHER_API_KEY=
VITE_WEATHER_API_PROVIDER=openweathermap

# Stripe (Payment)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_

# Sentry (Error Tracking)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Analytics
VITE_GOOGLE_ANALYTICS_ID=
VITE_MIXPANEL_TOKEN=

# ============================================================================
# GEOGRAPHIC CONFIGURATION
# ============================================================================
VITE_DEFAULT_COUNTRY=IN
VITE_DEFAULT_REGION=NORTHEAST_INDIA
VITE_DEFAULT_TIMEZONE=Asia/Kolkata
VITE_DEFAULT_CURRENCY=INR
VITE_DEFAULT_LANGUAGE=en

# ============================================================================
# UI CONFIGURATION
# ============================================================================
VITE_THEME=light
VITE_DARK_MODE_ENABLED=true
VITE_RTL_ENABLED=false
VITE_MOBILE_RESPONSIVE=true

# ============================================================================
# DEVELOPMENT CONFIGURATION
# ============================================================================
VITE_MOCK_API=false
VITE_LOG_NETWORK_REQUESTS=true
VITE_LOG_STATE_CHANGES=true
VITE_ENABLE_DEVTOOLS=true

# ============================================================================
# PERFORMANCE
# ============================================================================
VITE_ENABLE_LAZY_LOADING=true
VITE_ENABLE_CODE_SPLITTING=true
VITE_ENABLE_COMPRESSION=true
VITE_IMAGE_OPTIMIZATION=true
VITE_MAX_BUNDLE_SIZE=1000

# ============================================================================
# SECURITY
# ============================================================================
VITE_ENABLE_HTTPS_ONLY=false
VITE_ENABLE_CSP=true
VITE_ENABLE_X_FRAME_OPTIONS=true
VITE_ENABLE_SECURE_COOKIES=false

# ============================================================================
# BUILD CONFIGURATION
# ============================================================================
VITE_SOURCE_MAPS=true
VITE_MINIFY=true
VITE_OPTIMIZE_IMAGES=true
