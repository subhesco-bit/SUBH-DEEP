 "screen_specs": [
  {
   "screen": "Login (OTP-based)",
   "process": "Driver enters phone number. Server sends OTP.",
   "wiring": "Links to /fieldops (certification check). If DL expired, login is blocked."
  },
  {
   "screen": "Availability Toggle",
   "process": "Swipe \"Go Online\" / \"Go Offline\". Sends GPS location to server every 5 seconds.",
   "wiring": "Updates driver_availability table. Feeds real-time data to the /orderrouting AI."
  },
  {
   "screen": "Job List / Offer",
   "process": "Receives a push notification for a new order. Shows Pickup Location, Weight, Distance, Estimated Earning.",
   "wiring": "Triggered by the server's RouteAssignment() action (Part 1.2)."
  },
  {
   "screen": "Accept / Reject",
   "process": "Driver taps \"Accept\". Server locks the order and assigns it.",
   "wiring": "Updates shipments.assigned_driver_id and orders.status."
  },
  {
   "screen": "Navigation",
   "process": "Opens integrated Maps (Google/OSM) to the pickup point.",
   "wiring": "N/A (Utility)."
  },
  {
   "screen": "Scan & Pickup",
   "process": "Driver scans a QR code on the farmer's consignment label. Marks \"Picked Up\".",
   "wiring": "Updates shipments.status = IN_TRANSIT. Sends SMS to buyer."
  },
  {
   "screen": "Delivery & OTP",
   "process": "Driver reaches buyer location. Buyer provides a 4-digit OTP (from SMS). Driver enters OTP to complete.",
   "wiring": "Calls the Escrow Release API (Part 1.2). Triggers the platform settlement."
  },
  {
   "screen": "Earnings Wallet",
   "process": "Shows daily trip count, total earnings, payout history.",
   "wiring": "Reads from the transactions table."
  },
  {
   "screen": "Ticket Queue",
   "process": "Lists all open complaints (/care) with an SLA timer.",
   "wiring": "Fetches from complaints table. Sorts by sla_deadline (SLA breach alerts)."
  },
  {
   "screen": "Agent Assignment",
   "process": "Agent taps \"Assign to Me\". Complaint status changes from \"Open\" to \"Assigned\".",
   "wiring": "Updates complaints.assigned_agent_id. Logs the action in the audit trail."
  },
  {
   "screen": "Warehouse / FEFO Picking",
   "process": "Warehouse agent receives a \"Pick List\" for a new order. Scans barcode of the rack to confirm.",
   "wiring": "Connects to /warehouse module. Updates inventory_lots.qty_available in real-time."
  },
  {
   "screen": "Facility Approvals",
   "process": "Approves cold-storage bookings (/facilities) or Media Uploads (/medialibrary).",
   "wiring": "Updates facility_bookings.status or media_assets.status."
  },
  {
   "screen": "New Order Alert",
   "process": "Farmer receives a push notification when a buyer places an order for their MAP-A floor.",
   "wiring": "Fetches from inventory_lots and orders table."
  },
  {
   "screen": "Dynamic Pricing Suggestion",
   "process": "Farmer receives an AI-generated price adjustment suggestion (from /dynamicpricing) on their dashboard.",
   "wiring": "Pushes recommendations from dpRecommend() calculation."
  },
  {
   "screen": "Payout Notification",
   "process": "Farmer gets a \"Money Credited\" alert when the escrow is released.",
   "wiring": "Triggered by Transaction.Settled event."
  }
 ]
