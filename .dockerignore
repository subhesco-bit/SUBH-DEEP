# ════════════════════════════════════════════════════════════
# .dockerignore - Exclude files from Docker build context
# ════════════════════════════════════════════════════════════

# Version Control
.git
.gitignore
.gitattributes

# CI/CD
.github
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml
.circleci

# Development
node_modules
npm-debug.log
npm-error.log
yarn-error.log
pnpm-debug.log
.npm
.env.local
.env.*.local
.pnpm-store

# IDEs & Editors
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings
*.iml

# Documentation
README.md
CHANGELOG.md
LICENSE
docs/
*.md
!**/*migration*.md

# Build artifacts
dist/
build/
out/
.next/
.cache/
.parcel-cache/

# Test files
__tests__
test/
tests/
coverage/
*.test.js
*.spec.js
jest.config.js
.nyc_output/

# Logs
logs/
*.log
.pnpm-debug.log*

# AI/Development agents
.ai/
.claude/
.cursor/
.devin/
.vibecheck/
.consolidation_work/

# Reports & Documentation (project-specific clutter)
*_REPORT.md
*_AUDIT.md
*_SUMMARY.md
*_GUIDE.md
*_CHECKLIST.md
*100_PERCENT*.md
*COMPLETION*.md
*CERTIFICATE*.md
CURRENT_STATUS.html
*.json
!package*.json
!tsconfig.json
!babel.config.js
!jest.config.js

# Database files
*.sqlite
*.sqlite3
*.db
*.sql

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Docker/Container files (avoid nested images)
Dockerfile.dev
Dockerfile.test
docker-compose.dev.yml
docker-compose.test.yml
.dockerignore.bak

# Temporary files
tmp/
temp/
.tmp/
*.tmp

# Architecture/design files
.consolidation_work/
EBDESIGN-COMPLETE/
DIYA-AADI/
DOCUMENTATION/

# Large binary files
*.iso
*.zip
*.tar.gz
*.rar
*.7z

# Node modules in subdirectories (preserve only in built layers)
frontend/node_modules
backend/node_modules
