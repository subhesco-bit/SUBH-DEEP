# Docker Environment Configuration
# AFRERA Platform - Infrastructure Setup
#
# This file is git-tracked and MUST NOT contain real secrets — copy it to
# .env.docker.local (gitignored) and fill in real values there, or inject
# secrets via your deploy platform's secret manager. Previously this file
# committed real-looking hardcoded passwords directly; those values are
# still present in this repo's git history and should be treated as
# compromised and rotated if this stack was ever actually deployed with them.

# Database Passwords
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
REDIS_PASSWORD=CHANGE_ME_redis_password
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password

# Application Configuration
NODE_ENV=development
PORT=3003

# Database URLs (Docker internal)
DATABASE_URL=postgresql://afrera_user:CHANGE_ME_postgres_password@postgres:5432/afrera_prod
MONGODB_URL=mongodb://mongodb:27017/afrera_mongo_prod
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379
RABBITMQ_URL=amqp://afrera_user:CHANGE_ME_rabbitmq_password@rabbitmq:5672
ELASTICSEARCH_URL=http://elasticsearch:9200

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Authentication
JWT_SECRET=CHANGE_ME_jwt_secret_use_a_long_random_value
JWT_EXPIRY=7d
REFRESH_TOKEN_EXPIRY=30d

# AI Services (Optional - Configure as needed)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ERP Configuration (Optional - Configure as needed)
SAP_ENABLED=false
SAP_HOST=
SAP_PORT=
SAP_CLIENT=
SAP_USER=
SAP_PASSWORD=
SAP_SYSTEM_ID=

ORACLE_ENABLED=false
ORACLE_HOST=
ORACLE_PORT=
ORACLE_SERVICE=
ORACLE_USER=
ORACLE_PASSWORD=

CUSTOM_ERP_ENABLED=false
CUSTOM_ERP_API_URL=
CUSTOM_ERP_API_KEY=

# External Services (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Security
ENCRYPTION_KEY=CHANGE_ME_encryption_key_use_a_long_random_value

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/development.log

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Monitoring
ERROR_MONITORING_ENABLED=true
PERFORMANCE_MONITORING_ENABLED=true

# Security
HELMET_ENABLED=true
COMPRESSION_ENABLED=true
