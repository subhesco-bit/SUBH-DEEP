# Production Environment Variables
# These should be set in your CI/CD pipeline or production environment

# API Configuration
VITE_API_URL=https://api.afrera.com/api/v1
VITE_WS_URL=wss://api.afrera.com

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_MFA=true
VITE_ENABLE_GDPR=true

# Monitoring
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# Rate Limiting
VITE_RATE_LIMIT_ENABLED=true
VITE_RATE_LIMIT_MAX_REQUESTS=100
VITE_RATE_LIMIT_WINDOW_MS=900000

# Cache Configuration
VITE_CACHE_ENABLED=true
VITE_CACHE_TTL=300000

# CDN Configuration
VITE_CDN_URL=https://cdn.afrera.com

# Branding
VITE_APP_NAME=AFRERA
VITE_APP_VERSION=1.0.0
