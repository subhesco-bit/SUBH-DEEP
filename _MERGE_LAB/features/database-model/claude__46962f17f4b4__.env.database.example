NODE_ENV=development

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=subh_dev
POSTGRES_USER=subh_admin
POSTGRES_PASSWORD=CHANGE_LOCAL_PASSWORD

DATABASE_URL=postgresql://subh_admin:CHANGE_LOCAL_PASSWORD@localhost:5432/subh_dev

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

DB_POOL_MIN=2
DB_POOL_MAX=20

DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000

DB_SSL=false

# Production credentials must be supplied through secret management.
