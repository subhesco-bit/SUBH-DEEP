# AFRERA Backend — environment template
# Copy to .env and fill in real values. NEVER commit the real .env.
# Generated 2026-08-03 from the 59 process.env references found in backend/src.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info
LOG_DIR=logs
ENABLE_GRAPHQL=false

# ---------------------------------------------------------------------------
# PostgreSQL (primary relational store)
# ---------------------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=afrera_db
PG_USER=postgres
PG_PASSWORD=
# Used by migrate.js / seed.js (full connection string form)
DATABASE_URL=postgresql://postgres:password@localhost:5432/afrera_db
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/afrera_test

# ---------------------------------------------------------------------------
# MongoDB (document store)
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/afrera_mongo
MONGODB_URI=mongodb://localhost:27017/afrera_mongo
MONGO_DATABASE=afrera_mongo

# ---------------------------------------------------------------------------
# Redis (cache / queues)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------------------------------------------------------------------------
# Auth / crypto
# REQUIRED IN PRODUCTION. The app falls back to an insecure default JWT secret
# if this is unset — see authService.js. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=afrera-platform
JWT_AUDIENCE=afrera-users
ENCRYPTION_KEY=
OFFLINE_PAYMENT_SECRET=
SYNC_SECRET=
# Comma-separated IPs allowed to bypass certain rate limits
TRUSTED_IPS=

# ---------------------------------------------------------------------------
# OAuth providers (optional — leave *_ENABLED=false to disable)
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/oauth/google/callback
GOOGLE_PROJECT_ID=

FACEBOOK_OAUTH_ENABLED=false
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3001/api/v1/auth/oauth/facebook/callback

# ---------------------------------------------------------------------------
# Twilio (SMS / voice / WhatsApp) — runs in mock mode when unset
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VOICE_ENABLED=false
# WhatsApp-enabled Twilio sender (Sandbox number or an approved WhatsApp
# Business sender) — separate from TWILIO_PHONE_NUMBER above, which is
# SMS-only. See services/whatsappService.js header for why these differ.
TWILIO_WHATSAPP_NUMBER=
# Externally reachable base URL Twilio calls (e.g. https://api.example.com).
# Used to validate the inbound WhatsApp webhook's X-Twilio-Signature; without
# it the URL is reconstructed from the request, which can be wrong behind a
# proxy/load balancer.
PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# ERP integrations
# NOTE: SAP and Oracle paths in erpService.js are currently SIMULATED and do
# not make real calls. Enabling these does not yet produce real integration.
# ---------------------------------------------------------------------------
SAP_ENABLED=false
SAP_HOST=
SAP_PORT=
SAP_CLIENT=
SAP_SYSTEM_ID=
SAP_USER=
SAP_PASSWORD=

ORACLE_ENABLED=false
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE=
ORACLE_USER=
ORACLE_PASSWORD=

CUSTOM_ERP_ENABLED=false
CUSTOM_ERP_API_URL=
CUSTOM_ERP_API_KEY=

# AI Learning Cycle Configuration
AI_LEARNING_CYCLE=on
AI_LEARNING_CYCLE_MINUTES=60

# GraphQL Configuration
ENABLE_GRAPHQL=false

# Mandi Price Refresh Configuration
MANDI_PRICE_REFRESH=on
MANDI_PRICE_REFRESH_HOURS=24

# ---------------------------------------------------------------------------
# AI Backbone (services/aiBackboneService.js) — real provider integrations,
# mounted at /api/v1/ai-backbone. Each provider is independently optional:
# leave *_ENABLED=false (or the key blank) to skip it. callAI() with no
# explicit provider picks the first enabled+configured one, in the order
# claude > openai > gemini > azure > huggingface.
# ---------------------------------------------------------------------------
CLAUDE_ENABLED=false
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=4096

OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-turbo
OPENAI_MAX_TOKENS=4096

GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro
GEMINI_MAX_TOKENS=4096

AZURE_OPENAI_ENABLED=false
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

HUGGINGFACE_ENABLED=false
HUGGINGFACE_API_KEY=
HUGGINGFACE_DEFAULT_MODEL=meta-llama/Llama-2-7b-chat-hf

# ---------------------------------------------------------------------------
# Wearable Integration (services/wearableIntegrationService.js)
# Fitbit only — it is the one provider here with a real public server-side
# OAuth2 REST API. Apple Health / Samsung Health have no equivalent third-
# party cloud API and are intentionally NOT configured via env vars here;
# they are ingested only when AFRERA's mobile app pushes device-read data to
# POST /api/v1/wearable-integration/sync. Do not add fake API keys for them.
# ---------------------------------------------------------------------------
# Must point at the FRONTEND callback page, not the backend — Fitbit redirects
# the browser here via GET ?code=..., and the frontend page then POSTs that
# code to POST /api/v1/wearable-integration/fitbit/callback itself.
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=http://localhost:3000/wearables/fitbit-callback

# ---------------------------------------------------------------------------
# Crop Value-Compound Research (services/cropValueResearchService.js) — "AI
# searches and adds/updates reference data when a product is added." Needs a
# real web search API so the AI is grounded in actual search results, not
# recalling from memory. Leave unset to keep this feature honestly
# not_configured (every write from this service is unverified regardless —
# see verified column in crop_value_compound_reference — so no downstream
# harm from leaving it off).
# ---------------------------------------------------------------------------
BING_SEARCH_API_KEY=
SERPAPI_KEY=
