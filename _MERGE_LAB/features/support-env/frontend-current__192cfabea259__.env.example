# EBDESIGN Frontend Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================
# API CONFIGURATION
# ============================================
VITE_API_BASE_URL=http://localhost:3001
VITE_API_TIMEOUT=30000

# ============================================
# APPLICATION CONFIGURATION
# ============================================
VITE_APP_NAME=EBDESIGN
VITE_APP_DESCRIPTION=Subhesco/EBDESIGN Agricultural Digital Operating System
VITE_APP_URL=http://localhost:3000

# ============================================
# AUTHENTICATION CONFIGURATION
# ============================================
VITE_TOKEN_STORAGE=localStorage

# ============================================
# FEATURE FLAGS
# ============================================
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_PWA=true
VITE_ENABLE_OFFLINE_MODE=false

# ============================================
# AI SERVICES CONFIGURATION
# ============================================
VITE_CLAUDE_API_ENABLED=true
VITE_AI_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# ============================================
# MONITORING CONFIGURATION
# ============================================
VITE_SENTRY_DSN=your-sentry-dsn
VITE_ENABLE_PERFORMANCE_MONITORING=true

# ============================================
# PAYMENT CONFIGURATION
# ============================================
VITE_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
VITE_RAZORPAY_KEY_ID=your-razorpay-key-id

# ============================================
# THIRD-PARTY SERVICES
# ============================================
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_GOOGLE_ANALYTICS_ID=your-google-analytics-id

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ============================================
# PAGINATION CONFIGURATION
# ============================================
VITE_DEFAULT_PAGE_SIZE=20
VITE_MAX_PAGE_SIZE=100

# ============================================
# CACHE CONFIGURATION
# ============================================
VITE_CACHE_TTL=300000
VITE_ENABLE_CACHE=true
