{
  "root": true,
  "env": {
    "node": true,
    "es2022": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "extends": ["eslint:recommended"],
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_|^next$|^req$|^res$" }],
    "no-console": "off",
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "prefer-const": "warn",
    "eqeqeq": ["warn", "smart"],
    "no-throw-literal": "error",
    "no-return-await": "warn",
    "require-atomic-updates": "off"
  },
  "ignorePatterns": ["node_modules/", "coverage/", "dist/", "*.sql"]
}
