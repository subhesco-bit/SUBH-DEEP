{
  "prettier.semi": true,
  "editor.rulers": [
    80,
    120
  ],
  "git.autorefresh": true,
  "files.exclude": {
    "build": true,
    ".git": true,
    "dist": true,
    "node_modules": true
  },
  "prettier.trailingComma": "es5",
  "editor.formatOnSave": true,
  "git.autofetch": true,
  "search.exclude": {
    ".git": true,
    "node_modules": true
  },
  "prettier.singleQuote": true,
  "git.confirmSync": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode"
}
