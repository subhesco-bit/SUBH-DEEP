{
  "project": {
    "name": "AFRERA",
    "version": "2.0.0",
    "environment": "production",
    "debug": false
  },
  "server": {
    "port": 3001,
    "host": "0.0.0.0",
    "cors": {
      "enabled": true,
      "origins": ["https://afrera.com", "https://www.afrera.com"]
    }
  },
  "database": {
    "type": "postgresql",
    "host": "${DB_HOST}",
    "port": "${DB_PORT}",
    "database": "${DB_NAME}",
    "user": "${DB_USER}",
    "password": "${DB_PASSWORD}",
    "pool": {
      "min": 10,
      "max": 50,
      "idle": 30000
    }
  },
  "claudeAI": {
    "model": "claude-3-5-sonnet-20241022",
    "maxTokens": 8192,
    "temperature": 0.7,
    "contextWindow": 200000,
    "safetyFilters": true,
    "costMonitoring": true
  },
  "monitoring": {
    "enabled": true,
    "metrics": ["performance", "ai_usage", "errors", "user_activity"],
    "logging": {
      "level": "info",
      "format": "json"
    }
  },
  "features": {
    "testing": false,
    "development": false,
    "maintenance": false
  }
}
