# AFRERA / EBDESIGN backend environment contract
# Development defaults only. Production secrets belong in a secret manager.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
ALLOW_DEGRADED_STARTUP=false

# PostgreSQL — canonical contract used by runtime and migrations
DATABASE_URL=
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=afrera_db
PG_USER=postgres
PG_PASSWORD=password
PG_SSL=false
PG_SSL_STRICT=true
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000

# MongoDB — optional unless MONGO_REQUIRED=true
MONGO_URI=
MONGO_DATABASE=afrera_mongo
MONGO_REQUIRED=false
MONGO_POOL_MAX=20
MONGO_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000

# Redis / cache / jobs
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Security — replace all development values in production
JWT_SECRET=dev_jwt_secret_change_in_production
JWT_EXPIRY=7d
REFRESH_TOKEN_SECRET=dev_refresh_secret_change_in_production
SESSION_SECRET=dev_session_secret_change_in_production
ENABLE_MFA=true
CORS_ORIGIN=http://localhost:5173

# AI providers — keys only through local untracked env or deployment secret manager
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
ENABLE_AI_FEATURES=true

# Email
SMTP_HOST=localhost
SMTP_PORT=1025

# Governance
ENABLE_GDPR=true
