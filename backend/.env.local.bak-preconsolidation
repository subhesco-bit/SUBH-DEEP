# ============================================================================
# CACHE & MESSAGE QUEUE
# ============================================================================
# Redis (for caching, sessions, jobs)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB (for document storage)
MONGO_URI=mongodb://afrera:afrera_password@localhost:27017/afrera_mongo?authSource=admin
MONGO_HOST=localhost
MONGO_PORT=27017

# RabbitMQ (for messaging)
RABBITMQ_URL=amqp://afrera:afrera_password@localhost:5672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Elasticsearch (for search)
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://localhost:9200

# ============================================================================
# ENVIRONMENT & PORT
# ============================================================================
NODE_ENV=development
PORT=5000

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ============================================================================
# ANTHROPIC CLAUDE AI CONFIGURATION
# ============================================================================
# Get your key from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-v7-_YOUR_KEY_HERE_
CLAUDE_API_KEY=sk-ant-v7-_YOUR_KEY_HERE_
CLAUDE_MODEL=claude-opus-5

# Fallback mode for when API key is not set (uses mock responses)
CLAUDE_API_FALLBACK_MODE=true

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# JWT Configuration
JWT_SECRET=dev_local_secret_change_in_production_12345
JWT_EXPIRY=7d
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
REFRESH_TOKEN_SECRET=dev_refresh_secret_change_in_production

# Session Configuration
SESSION_SECRET=dev_session_secret_change_in_production
SESSION_COOKIE_SECURE=false  # false for localhost (no HTTPS)
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# OAuth2 (optional for development)
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret
OAUTH_CALLBACK_URL=http://localhost:5000/auth/callback

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_FILE=logs/app.log
LOG_MAX_FILES=7

# ============================================================================
# EMAIL (Optional for development)
# ============================================================================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dev
SMTP_PASSWORD=dev
SMTP_FROM=noreply@ebdesign.local
SMTP_TLS=false

# ============================================================================
# SECURITY FEATURES
# ============================================================================
# Multi-Factor Authentication
ENABLE_MFA=true
MFA_ISSUER=EBDESIGN
MFA_WINDOW=30  # Time window for TOTP (seconds)

# GDPR & Privacy
ENABLE_GDPR=true
GDPR_DATA_RETENTION_DAYS=365

# AI Features
ENABLE_AI_FEATURES=true
ENABLE_AI_COLLABORATION=true

# ============================================================================
# IMAGE GENERATION (Devin Integration)
# ============================================================================
AUTO_IMAGE_GENERATION=true
AUTO_GENERATE_ON_PRODUCT_ADD=true
AUTO_GENERATE_ON_PAGE_VIEW=true
AUTO_GENERATE_ON_INVENTORY_UPDATE=true

DEFAULT_REGION=global-export
DEFAULT_LANGUAGES=en,hi

# Batch processing
AUTO_GEN_BATCH_SIZE=10
AUTO_GEN_MAX_CONCURRENT=3
AUTO_GEN_CHECK_INTERVAL=5000

# Image Generation
IMAGE_GENERATION_TIMEOUT=30000
USE_REAL_IMAGE_API=false
CDN_ENABLED=false
MARKETPLACE_URL=http://localhost:5173/marketplace

# ============================================================================
# DEVIN COPILOT CONFIGURATION
