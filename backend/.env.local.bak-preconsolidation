DEVIN_ENABLED=true
DEVIN_API_KEY=apk_b3JnLTgyOTBhMmE3M2YwZjQ2Y2FhMjE1NTdjM2FkYzkwMmIwOmFkNDgyZWNlMGYyZTQzMTNhZjc1NDIwNzllMzIwMWVl
DEVIN_API_URL=https://api.devin.ai/v1
