# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# For Docker Compose (recommended):
DATABASE_URL=postgresql://afrera_user:AfreraSecure2024!DB@localhost:5432/afrera_prod
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ebdesign_prod
DB_USER=postgres
