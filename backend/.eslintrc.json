{
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": "off",
    "no-unused-vars": "off",
    "prefer-const": "off",
    "no-trailing-spaces": "off",
    "comma-dangle": "off",
    "quotes": "off",
    "no-implicit-coercion": "off",
    "no-sync": "off",
    "no-undef": "off",
    "no-empty-pattern": "off",
    "no-useless-catch": "off",
    "no-prototype-builtins": "off",
    "no-redeclare": "off",
    "no-constant-condition": "off",
    "no-fallthrough": "off",
    "no-case-declarations": "off",
    "default-case": "off",
    "eqeqeq": "off",
    "no-eq-null": "off",
    "no-irregular-whitespace": "off",
    "no-mixed-spaces-and-tabs": "off",
    "no-regex-spaces": "off",
    "no-unreachable": "off"
  },
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "build/",
    ".next/"
  ],
  "overrides": [
    {
      "files": ["**/*.test.js", "**/*.spec.js"],
      "env": { "jest": true },
      "globals": {
        "describe": "readonly",
        "it": "readonly",
        "test": "readonly",
        "expect": "readonly",
        "beforeEach": "readonly",
        "afterEach": "readonly",
        "beforeAll": "readonly",
        "afterAll": "readonly",
        "jest": "readonly"
      }
    },
    {
      "files": [
        "src/services/ai/knowledgeGraphService.js",
        "src/services/ai/predictiveAnalyticsService.js",
        "src/services/commerce/valueCommerceService.js",
        "src/services/food/nutritionIntelligenceService.js",
        "src/services/logistics/iotIntegrationService.js",
        "src/services/platform/multilingualService.js"
      ],
      "rules": {
        "no-func-assign": "off"
      }
    },
    {
      "files": ["src/middleware/security.js"],
      "rules": {
        "no-useless-escape": "off"
      }
    }
  ]
}
