    "audit:system": "node ../tools/system-production-audit.js",
    "audit:m001-m050": "node ../tools/m001-m050-release-audit.js",
    "audit:complete": "npm run audit:coverage && npm run audit:production && npm run audit:system",
    "upgrade:all": "node ../tools/upgrade-all.js",
    "verify:production": "npm run lint && npm test -- --runInBand && npm run audit:complete"
  },
