{
  "project": {
    "name": "AFRERA",
    "version": "2.0.0",
    "environment": "development",
    "debug": true
  },
  "server": {
    "port": 3001,
    "host": "localhost",
    "cors": {
      "enabled": true,
      "origins": ["http://localhost:5173", "http://localhost:3000"]
    }
  },
  "database": {
    "type": "postgresql",
    "host": "localhost",
    "port": 5432,
    "database": "afrera_dev",
    "user": "postgres",
    "password": "postgres",
    "pool": {
      "min": 2,
      "max": 20,
      "idle": 10000
    }
  },
  "claudeAI": {
    "model": "claude-3-5-sonnet-20241022",
    "maxTokens": 8192,
    "temperature": 0.7,
    "contextWindow": 200000,
    "safetyFilters": true,
    "costMonitoring": true
  },
  "monitoring": {
    "enabled": true,
    "metrics": ["performance", "ai_usage", "errors", "user_activity"],
    "logging": {
      "level": "debug",
      "format": "json"
    }
  },
  "features": {
    "testing": true,
    "development": true,
    "maintenance": false
  }
}
